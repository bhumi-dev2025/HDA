{
  "expo": {
    "name": "Human Design Academy",
    "slug": "HumanDesignAcademy",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "8",
      "supportsTablet": false,
      "bundleIdentifier": "com.simple.humandesignacademy",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.241217798940-ipmglh828epjv8q7v0ob4lrf2pvnuhs3"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "This app reads your step count from Apple Health to track your daily activity.",
        "NSHealthUpdateUsageDescription": "This app may write health data to Apple Health if needed."
      }
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.simple.humandesignacademy",
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "healthSharePermission": "This app reads step count from Apple Health",
          "healthUpdatePermission": "This app may write health data if needed"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos so you can select and save ID cards locally on your device. Your photos remain private and are not uploaded to any external server."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2434c038-7701-4b2f-a67f-78b633519fb1"
      }
    }
  }
}
